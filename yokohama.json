  "criticalRisks": [

    {

      "severity": "high",

      "id": "risk-concert-to-nikko",

      "title": "10/29演唱會散場 → 10/30凌晨05:10出發",

      "detail": "K-Arena大型公演採管制退場,全場散完約需40-50分鐘。所幸飯店緊鄰會場,不需前往車站,這是最大優勢。但若演唱會21:00結束、22:00前後回房,扣除盥洗只剩約6小時睡眠,隔天須05:00起床。",

      "mitigation": [

        "演唱會當晚不安排續攤或宵夜。",

        "10/29出發前先把10/30的隨身物品整理好放門邊。",

        "早餐改為前一日買好的麵包,不依賴飯店餐廳。",

        "若演唱會結束時間晚於22:00,應認真考慮放棄日光團。"

      ],

      "sourceRefs": [

        "karena-exit"

      ]

    },

    {

      "severity": "high",

      "id": "risk-nikko-departure",

      "title": "10/30東京站06:30,容錯極低",

      "detail": "05:25橫濱站發車(東海道線)是主要班次,下一班05:53抵東京約06:20,只剩10分鐘找丸之內北口。再錯過就趕不上集合。",

      "mitigation": [

        "設兩個鬧鐘",

        "10/28或10/29白天先走一次飯店到橫濱站的路線",

        "確認夜間可通行的出入口"

      ],

      "sourceRefs": [

        "yokohama-tokyo-rail"

      ]

    },

    {

      "severity": "medium",

      "id": "risk-return-legs",

      "title": "兩天團體返回後仍需回橫濱",

      "detail": "返回地點=上車地點。10/30晚回到東京站後還需約25-30分鐘回橫濱;10/31晚回到上野站後需約40-50分鐘。兩天都是清晨出門、深夜返回。",

      "mitigation": [

        "回程可加購綠色車廂(Suica事前購買50km內750日圓,車站/車內紙票貴260日圓)",

